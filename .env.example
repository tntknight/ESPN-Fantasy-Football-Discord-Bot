# --- Discord ---
# Create an application + bot at https://discord.com/developers/applications
# Enable no privileged intents (this bot doesn't read message content).
# Invite it with scopes "bot applications.commands" and permissions
# Send Messages + Embed Links.
DISCORD_TOKEN=
# Right-click the channel in Discord (Developer Mode must be on) -> Copy Channel ID
DISCORD_CHANNEL_ID=

# --- ESPN ---
ESPN_LEAGUE_ID=
ESPN_YEAR=2026

# Private leagues only. Log into fantasy.espn.com in a browser, open DevTools ->
# Application/Storage -> Cookies -> fantasy.espn.com, and copy these two values.
ESPN_SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
ESPN_S2=

# --- Scheduling (all times are in TIMEZONE, 24h clock) ---
TIMEZONE=America/New_York

# Weekly recap: posted once per week on this day/hour once ESPN shows the week final
RECAP_DAY=Tue
RECAP_HOUR=9

# Matchup preview: posted once per week ahead of kickoff
PREVIEW_DAY=Thu
PREVIEW_HOUR=18

# Live score alerts: only polls during typical NFL game windows (Thu/Sun/Mon)
LIVE_POLL_MINUTES=15
LIVE_CLOSE_MARGIN=15

# Where bot/state.py persists "already posted" tracking between restarts
STATE_FILE=state.json
